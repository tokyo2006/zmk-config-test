#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        flash {
            bindings = <&bootloader>;
            key-positions = <0 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";
            bindings = <
&kp ESCAPE      &kp N1        &kp N2        &kp N3  &kp N4  &kp N5                               &kp N6  &kp N7      &kp N8            &kp N9             &kp N0         &kp BACKSPACE
&kp TAB         &kp Q         &kp W         &kp E   &kp R   &kp T                                &kp Y   &kp U       &kp I             &kp O              &kp P          &kp NON_US_BACKSLASH
&kp CLCK        &kp A         &kp S         &kp D   &kp F   &kp G                                &kp H   &kp J       &kp K             &kp L              &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C   &kp V   &kp B   &kp C_PLAY_PAUSE  &mkp LCLK  &kp N   &kp M       &kp COMMA         &kp PERIOD         &kp QUESTION   &kp ENTER
&kp RCTRL       &kp LEFT_GUI  &kp LEFT_ALT  &kp A   &kp A   &mo 1   &kp SPACE         &kp SPACE  &mo 2   &kp DELETE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS      &kp EQUAL
            >;

            sensor-bindings = <&rsr_vol>;
        };

        LOWER {
            display-name = "Lower";
            bindings = <
&kp TILDE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans     &kp Z   &kp Z   &kp Z   &kp Z   &kp Z                 &kp Z   &kp Z   &kp Z   &kp Z   &kp Z    &kp LS(NON_US_BACKSLASH)
&kp Z      &kp Z   &kp Z   &kp Z   &kp Z   &kp Z                 &kp Z   &kp Z   &kp Z   &kp Z   &kp Z    &kp Z
&kp Z      &kp Z   &kp Z   &kp Z   &kp Z   &kp Z   &kp Z  &kp Z  &kp Z   &kp Z   &kp Z   &kp Z   &kp Z    &kp Z
&kp Z      &kp Z   &kp Z   &kp Z   &kp Z   &kp Z   &kp Z  &kp Z  &kp Z   &kp Z   &kp Z   &kp Z   &kp Z    &ext_power EP_ON
            >;

            sensor-bindings = <&rsr_vol>;
        };

        RAISE {
            display-name = "Raise";
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp F12
&kp 1      &bt BT_CLR    &bt BT_CLR_ALL  &kp 1         &kp 1         &kp 1                       &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1
&kp 1      &kp 1         &kp 1           &kp 1         &kp 1         &kp 1                       &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1
&kp 1      &kp 1         &kp 1           &kp 1         &kp 1         &kp 1         &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1
&kp 1      &kp 1         &kp 1           &kp 1         &kp 1         &kp 1         &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1  &kp 1
            >;

            sensor-bindings = <&rsr_vol>;
        };

        ADJUST {
            display-name = "Adjust";
            bindings = <
&kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE                        &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE
&kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE                        &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE
&kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE                        &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE
&kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE
&kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE  &kp GRAVE
            >;

            sensor-bindings = <&rsr_vol>;
        };
    };
};
