/*
 * Azoteq TPS43 (IQS5xx) trackpad (I2C) on the right (central) half.
 *
 * Pins: SDA = P1.08, SCL = P0.24, RST = P1.04 (active-low),
 *       RDY = P1.07 (active-high).
 */

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 8)>,
                    <NRF_PSEL(TWIM_SCL, 0, 24)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 8)>,
                    <NRF_PSEL(TWIM_SCL, 0, 24)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";
        reset-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
        rdy-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
        one-finger-tap;
        two-finger-tap;
        scroll;
    };
};

/ {
    tps43_input: tps43_input {
        compatible = "zmk,input-listener";
        device = <&tps43>;
    };
};
