/*
 * Cirque Pinnacle 1CA027 trackpad (SPI) on the right (central) half.
 *
 * Pins: SCK = P0.11, MOSI = P1.00, MISO = P0.08, CS = P0.07,
 *       DR (data ready) = P0.12 (active high).
 */

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 11)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 0)>,
                    <NRF_PSEL(SPIM_MISO, 0, 8)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 11)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 0)>,
                    <NRF_PSEL(SPIM_MISO, 0, 8)>;
            low-power-enable;
        };
    };
};

&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;

    trackpad: trackpad@0 {
        compatible = "cirque,pinnacle2";
        reg = <0>;
        spi-max-frequency = <1000000>;
        data-ready-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
        sensitivity = "2x";
        data-mode = "absolute";
        idle-packets-count = <3>;
        absolute-touch-min-z = <8>;
        absolute-relative-multiplier = <3>;
        absolute-relative-divisor = <10>;
        /*
         * TM035035 datasheet (v1.2) geometry:
         *   - Pinnacle absolute grid 0..2048 x 0..1536
         *   - clipped active range 128..1920 x 64..1472
         *   - the 31 mm circular sensing area is the ellipse inscribed in that
         *     range (Figure 6), so the reachable rim at 4-6 o'clock has a
         *     smaller x than the rectangle corner.
         *
         * Tap tuning (values are coordinate units; X ~57.8 units/mm,
         * Y ~45.4 units/mm on this 31 mm sensor):
         *  - touch-min-z 8 (was 12): the outermost electrodes couple weaker,
         *    so rim touches were being treated as "no touch" and the scroll
         *    latch kept resetting.
         *  - tap-max-movement 150 keeps rim taps working without making the
         *    pointer feel sticky.
         *  - tap-click-ms 50 so a host cannot coalesce the press/release pair.
         */
        absolute-tap-max-ms = <250>;
        absolute-tap-max-movement = <150>;
        absolute-tap-click-ms = <50>;
        absolute-tap-drag-enable;
        absolute-tap-drag-timeout-ms = <300>;
        /* Must be >= tap-max-movement, otherwise the second tap of a
         * double-click is not accepted as a nearby tap for tap-drag. */
        absolute-tap-drag-max-movement = <200>;
        /*
         * Secondary (right) click: bottom-right of the ellipse. The feedback
         * from the 800x490 build was that the zone reached 6 o'clock, so pull
         * the x boundary back to 1300 (5.9 mm right of centre) and the y
         * boundary to 1042 (3.9 mm below centre). That keeps 5 o'clock
         * (1472, 1378) and 4:30 (1657, 1265) while excluding the bottom
         * centre.
         */
        absolute-secondary-tap-area-width = <620>;
        absolute-secondary-tap-area-height = <430>;
        absolute-aux-tap-area-width = <0>;
        absolute-aux-tap-area-height = <0>;
        /* Edge motion is off for now: it moves the pointer while the finger
         * rests at the rim, which masks and confuses edge-scroll testing. */
        /* absolute-edge-motion-enable; */
        /* absolute-edge-motion-zone = <80>; */
        /* absolute-edge-motion-speed = <4>; */
        /* absolute-edge-motion-interval-ms = <10>; */
        /* absolute-edge-motion-start-ms = <120>; */
        /*
         * Right-edge scroll, elliptical ring latch. 55 = the outer 45% of the
         * radius (~7 mm on the 31 mm sensor), which is where a thumb actually
         * lands; 70 (~4.7 mm) turned out to be too thin to catch a normal
         * touchdown. absolute-scroll-zone stays as the legacy fallback.
         * Divisor 50 = 1 wheel tick per 50 coordinate units (~0.9 mm).
         */
        absolute-right-edge-scroll-enable;
        absolute-edge-scroll-ring-percent = <55>;
        absolute-scroll-zone = <300>;
        absolute-scroll-divisor = <50>;
        /* Datasheet recommendation: clip noisy coordinates to the active
         * range so rim samples cannot fall outside 128..1920 / 64..1472. */
        clipping-enable;
        startup-delay-ms = <1500>;
        primary-tap-enable;
        /* invert-y and glide-extend-enable are relative-mode only; they are
         * no-ops here because this node runs data-mode = "absolute". */
    };
};

/ {
    trackpad_input: trackpad_input {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
    };
};
