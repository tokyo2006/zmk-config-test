#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>
#include <behaviors/battery_history_request.dtsi>
#include "sofle_cirque.dtsi"

#include "rgb.dtsi"
#include "azoteq.dtsi"

/ {
    chosen {
        zmk,underglow = &led_strip;
    };

    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_1: pwm_led_1 {
            pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&kscan0 {
    row-gpios
                = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
    col-gpios
                = <&gpio0 19 (GPIO_ACTIVE_HIGH)>
                , <&gpio1 12 (GPIO_ACTIVE_HIGH)>
                , <&gpio1 14 (GPIO_ACTIVE_HIGH)>
                , <&gpio0 2 (GPIO_ACTIVE_HIGH)>
                , <&gpio0 3 (GPIO_ACTIVE_HIGH)>
                , <&gpio0 28 (GPIO_ACTIVE_HIGH)>
                , <&gpio1 9 (GPIO_ACTIVE_HIGH)>
    ;
};

&default_transform {
    col-offset = <7>;
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 23)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 23)>;
            low-power-enable;
        };
    };
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT1, 0, 22)>;
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT1, 0, 22)>;
            low-power-enable;
        };
    };
};

/*
 * PSP joystick on the main/central (right) half.
 *
 * X = P0.04 (AIN2), Y = P0.05 (AIN3), VCC = 3.3V, GND = GND.
 * Both pins are unused by the Sofle matrix, trackpad, RGB, PWM, UART,
 * I2C and SPI on this half.
 */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN2>;
        zephyr,resolution = <12>;
    };

    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN3>;
        zephyr,resolution = <12>;
    };
};

/ {
    psp_joystick: psp_joystick {
        compatible = "tokyo2006,psp-joystick";
        io-channels = <&adc 2>, <&adc 3>;
        io-channel-names = "x", "y";

        /*
         * Initial tuning. These values can be changed at runtime through the
         * tokyo2006__psp_joystick Studio RPC subsystem.
         */
        deadzone-percent = <8>;
        max-speed = <8>;
        curve-exponent-x100 = <100>;
    };

    psp_joystick_listener: psp_joystick_listener {
        compatible = "zmk,input-listener";
        device = <&psp_joystick>;
    };
};
